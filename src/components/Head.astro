---
// Starlight <head> override: adds browser-language detection on top of the default head.
//
// On an English page, the visitor is sent to the same page in their language when:
//   - they picked that language before with the language picker, or
//   - they haven't picked one yet and their browser asks for a language we have.
// Translated pages never redirect, and picking English in the picker stops all redirects.
import Default from '@astrojs/starlight/components/Head.astro';
import config from 'virtual:starlight/user-config';

const codes = Object.keys(config.locales ?? {}).filter((code) => code !== 'root');
const isEnglish = Astro.locals.starlightRoute.locale === undefined;
const isNotFound = Astro.locals.starlightRoute.id === '404';
---

<Default />

<script is:inline define:vars={{ codes, isEnglish, isNotFound }}>
  (() => {
    const KEY = 'sd-lang'; // 'en' or a locale code such as 'de'
    const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
    const save = (v) => { try { localStorage.setItem(KEY, v); } catch {} };
    const localeOf = (path) => codes.find((c) => path === `/${c}` || path.startsWith(`/${c}/`)) ?? 'en';

    // Remember the language the visitor picks in the header picker.
    document.addEventListener('change', (e) => {
      if (e.target instanceof HTMLSelectElement && e.target.closest('starlight-lang-select')) {
        save(localeOf(e.target.value));
      }
    }, true);

    if (!isEnglish || isNotFound) return;

    let target = read();
    if (target === null) {
      // First visit: take the browser's first preferred language that we have (English counts).
      for (const tag of navigator.languages ?? [navigator.language]) {
        const base = String(tag).toLowerCase().split('-')[0];
        if (base === 'en' || codes.includes(base)) { target = base; break; }
      }
    }
    if (target && target !== 'en' && codes.includes(target)) {
      save(target);
      location.replace(`/${target}${location.pathname}${location.search}${location.hash}`);
    }
  })();
</script>
